void rotationHoraire(int tab[6][8], int pivot, pivot c){
 
    int tab2[5][5];
    int i;
    int j;

    // on copie la zone
    for(i = 0; i < pivot; i++){
        for(j = 0; j < pivot; j++){
           tab2[i][j] = tab[c.ligne+i][c.colonne+j];
        }
    }

    // rotation horaire
    for(i = 0; i < pivot; i++){
        for(j = 0; j < pivot; j++){
            tab[c.ligne+i][c.colonne+j] = tab2[j][pivot-1-i];
        }
    }
}
