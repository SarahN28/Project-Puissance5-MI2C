#include <stdio.h>
#include <stdlib.h>
#include <time.h>
void *createPiste(int tab[6][8]){
  tab[0][0]=1;                //caré sur L1 C1
  tab[0][7]=1;                //caré sur L1 C8
  tab[5][0]=1;                //caré sur L6 C1
  tab[5][7]=1;                //caré sur L6 C8
}
void printGame(int tab[6][8]){
  for (int i=0; i<6; i++){
    for (int j=0; j<8; j++){
      if(tab[i][j]==0){
        printf("|  ");
       }
      else if(tab[i][j]==1){
        printf("|##");
       }
      else if(tab[i][j]==2){
        printf("|()");
       }
      else if(tab[i][j]==3){
        printf("|><");
       }
      else if(tab[i][j]==4){
        printf("|¤¤");
       }
     }
    printf("| \n");
   }
 }
int main(){
  int tab[6][8]={0};
  createPiste(tab);
  printGame(tab);
  return 0;
 }
