#include <stdio.h>
#include <stdlib.h>
#include <time.h>
typedef struct {
  int ligne;
  int colonne;
} Pivot;
Pivot choixPivot(int p, int tab[6][8]){
  int i=0, j=0;
  Pivot c;
  if (p==3){
    while (i<2 || i>5){
      printf("Choisir la ligne du pivot\n");
      scanf("%d", &i);
     }
    while (j<2 || j>7) {
      printf("Choisir la colonne du pivot\n");
      scanf("%d", &j);
     }
   }
  if (p==5){
    while (i<3 || i>4){
      printf("Choisir la ligne du pivot\n");
      scanf("%d", &i);
     }
    while (j<3 || j>6) {
      printf("Choisir la colonne du pivot\n");
      scanf("%d", &j);
     }
   }
