void deplacement_bas(int tab[][8], int j, int nbJ){
  int k, tmp, i;
  k=-1;
  i=5;
  while(j>=0){
    if (tab[i][j]=0 && j>k){
      k=i;
     }
    else if (tab[i][j]=1){
      k = -1;
    }
    else if (k>-1 && tab[i][j]>1 && tab[i][j]<nbJ+2){
      tmp = tab[i][j];
      tab[i][j] = tab[k][j];
      tab[k][j] = tmp;
      i=k;
      k=-1;
    }
    i=i-1;
 }

