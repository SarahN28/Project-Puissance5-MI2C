void deplacement_bas(int tab[][8], int i, int nbJ){
  int k, tmp, i;
  k=-1;
  i=5;
  while(i>=0){
    if (tab[i][j]=0 && i>k){
      k=i;
     }
    else if (tab[i][j]=1){
      k = -1;
    }
    else if (k>-1 && tab[i][j]>1 && tab[i][j]<nbJ+2){
      tmp = tab[i][j];
      tab[i][j] = tab[i][k];
      tab[i][k] = tmp;
      i=k;
      k=-1;
    }
    i=i-1;
 }

void gravite(int tab[][6], int nbJ){
  for (int i=0; i<8; i++){
    deplacement_bas(tab[][8], i, nbJ);
   }
 }
