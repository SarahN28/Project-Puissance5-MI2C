#include <stdio.h>
#include <stdlib.h>
#include <time.h>
void deplacement_bas(int tab[6][8], int j, int nbJ){
  int k, tmp, i;         
  k=-1;
  i=5;
  while(i>=0){
    if (tab[i][j]==0 && i>k){   
      k = i;                  
     }
    else if (tab[i][j]==1){       
      k = -1;                     
    }
    else if (k>-1 && tab[i][j]>1 && tab[i][j]<(nbJ+2)){
      tmp = tab[i][j];
      tab[i][j] = tab[k][j];
      tab[k][j] = tmp;
      i=k;
      k=-1;
    }
    i=i-1;
  }
 }
void gravite(int tab[][8], int nbJ){
  for (int j=0; j<8; j++){
    deplacement_bas(tab, j, nbJ);
   }
 }
void *createPiste(int tab[6][8]){
  tab[0][0]=1;                //caré sur L1 C1
  tab[0][7]=1;                //caré sur L1 C8
  tab[5][0]=1;                //caré sur L6 C1
  tab[5][7]=1;                //caré sur L6 C8
}
void printGame(int tab[6][8]){
  for (int i=0; i<6; i++){
    for (int j=0; j<8; j++){
      if(tab[i][j]==0){
        printf("|  ");
       }
      else if(tab[i][j]==1){
        printf("|##");
       }
      else if(tab[i][j]==2){
        printf("|()");
       }
      else if(tab[i][j]==3){
        printf("|><");
       }
      else if(tab[i][j]==4){
        printf("|¤¤");
       }
     }
    printf("| \n");
   }
 }
int main(){
  int tab[6][8]={0};
  createPiste(tab);
  printGame(tab);
  printf("\n");
  tab[0][2]=3;
  printGame(tab);
  printf("\n");
  gravite(tab, 3);
  printGame(tab);
  printf("\n");
  return 0;
 }
