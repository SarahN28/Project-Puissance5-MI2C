void deplacement_bas(int tab[][6], int i, int j){
  int tmp;
  if (tab[i][j]=0){
    if (tab[i][j-1]!=0 && tab[i][j-1]!=1)){
      tmp = tab[i][j-1];
      tab[i][j-1] = 0;
      tab[i][j] = tmp;
    }
  }

void gravite{
  for (int i=0; i<8; i++){
      for (int j=5; j>0; j--){
        deplacement_bas(tab[][8], i, j);
      }
  }
}
