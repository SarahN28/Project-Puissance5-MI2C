void deplacement_bas(int tab[][6], int i, int j){
  int tmp;
  if (tab[i][j]!=0 && tab[i][j]!=1){
    if (tab[i][j+1]==0){
      tmp = tab[i][j];
      tab[i][j] = 0;
      tab[i][j+1] = tmp;
    }
  }

void gravite{
  for (i=0; i<8; i++){
      for (j=0; j<5; j++){
        deplacement_bas(tab[][8], i, j);
      }
  }
}
